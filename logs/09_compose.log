$ cat .env
WEB_PORT=8090
APP_ENV=prod

$ docker compose config
name: compose
services:
  checker:
    command:
      - sh
      - -c
      - while true; do echo "[checker] web/health -> $$(wget -qO- http://web/health)";
        sleep 5; done
    image: busybox:1.37
    networks:
      default: null
    depends_on:
      web:
        condition: service_started
        required: true
  web:
    environment:
      APP_ENV: prod
    image: my-web:compose
    networks:
      default: null
    volumes:
      - type: volume
        source: webdata
        target: /data
        volume: {}
    build:
      context: C:\Users\user\Desktop\codissey\workstation\app
      dockerfile: Dockerfile
    ports:
      - mode: ingress
        target: 80
        published: "8090"
        protocol: tcp
networks:
  default:
    name: compose_default
volumes:
  webdata:
    name: compose_webdata

